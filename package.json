{
  "name": "@zazuko/k8s-rdf-exporter-server",
  "version": "0.0.4",
  "description": "HTTP server that provides the current state of a Kubernetes cluster as RDF",
  "main": "src/index.js",
  "type": "module",
  "private": true,
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/index.js",
    "release": "changeset git-tag",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 \"test/e2e/**/*.test.js\""
  },
  "author": "Zazuko GmbH",
  "license": "MIT",
  "dependencies": {
    "@tpluscode/rdf-string": "^1.3.4",
    "@zazuko/k8s-rdf-exporter": "^0.4.1",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@zazuko/env-node": "^3.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
